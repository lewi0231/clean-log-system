# E2E Test Environment Configuration
# Copy this to .env.local and adjust values as needed

# Base URL for the dashboard (default: http://localhost:3000)
E2E_BASE_URL=http://localhost:3000

# Supabase local development URL
SUPABASE_URL=http://localhost:54321

# Service role key - get from: cd database && supabase status
# This is auto-detected from supabase status if not set
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
