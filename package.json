{
  "name": "clean-log-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dashboard": "pnpm --filter dashboard",
    "mobile": "pnpm --filter @clean-log/mobile-app",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:mobile": "pnpm --filter @clean-log/mobile-app start",
    "build:dashboard": "pnpm --filter dashboard build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:edge-functions": "deno lint database/supabase/functions",
    "validate:functions-inventory": "deno run --allow-read=database/supabase/functions database/supabase/functions/scripts/validate-functions-inventory.ts",
    "test:edge-unit": "deno test --config database/deno.json --allow-all --ignore=\"**/*-integration.test.ts\" \"database/supabase/functions/**/__tests__/*.test.ts\"",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:codegen": "playwright codegen",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
