{
  "name": "clean-log-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dashboard": "pnpm --filter dashboard",
    "mobile": "pnpm --filter @clean-log/mobile-app",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:mobile": "pnpm --filter @clean-log/mobile-app start",
    "build:dashboard": "pnpm --filter dashboard build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:edge-functions": "deno lint database/supabase/functions",
    "validate:functions-inventory": "deno run --allow-read=database/supabase/functions database/supabase/functions/scripts/validate-functions-inventory.ts",
    "test:edge-unit": "deno test --config database/deno.json --allow-all --ignore=\"**/*-integration.test.ts\" \"database/supabase/functions/**/__tests__/*.test.ts\"",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:codegen": "playwright codegen",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "tar": ">=7.5.7",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.7",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.0",
      "undici": ">=6.24.0",
      "node-forge": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=3.0.0 <3.0.2": ">=3.0.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "lodash": ">=4.18.0",
      "@xmldom/xmldom": ">=0.8.12",
      "fast-uri": ">=3.1.1",
      "form-data": ">=4.0.6",
      "ws": ">=8.21.0",
      "vite": "7.3.5"
    }
  }
}
