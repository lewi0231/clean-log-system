{
  "imports": {
    "@supabase/functions-js": "jsr:@supabase/functions-js@2",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.49.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "server": "https://deno.land/std@0.168.0/http/server.ts",
    "dotenv": "jsr:@std/dotenv",
    "stripe": "npm:stripe@^18.0.0"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "tasks": {
    "test": "deno test --allow-all supabase/functions/**/__tests__/*.test.ts",
    "test:edge-unit": "deno test --allow-all --ignore=\"**/*-integration.test.ts\" \"supabase/functions/**/__tests__/*.test.ts\"",
    "test:integration": "deno test --allow-all --allow-env --allow-net supabase/functions/__tests__/*-integration.test.ts",
    "test:handler-pipeline": "deno test --allow-all supabase/functions/_utils/__tests__/handler-pipeline.test.ts"
  }
}
