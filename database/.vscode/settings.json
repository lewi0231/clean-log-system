{
  "deno.enable": true,
  "deno.enablePaths": ["supabase/functions"],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "typescript.enable": false,
  "typescript.validate.enable": false,
  "typescript.tsserver.enabled": false,
  "typescript.enableProjectDiagnostics": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "**/supabase/functions/**/*.ts": "typescript"
  }
}
